    "@cityssm/express-abuse-points": "^4.0.0",
    "@cityssm/expressjs-server-js": "^2.3.3",
    "@fortawesome/fontawesome-free": "^5.15.4",
    "activedirectory2": "^2.2.0",
    "better-sqlite3": "^13.0.3",
    "camelcase": "^9.0.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cross-env": "^10.1.0",
    "csurf": "^1.11.0",
    "debug": "^4.4.3",
    "ejs": "^6.0.1",
    "exit-hook": "^5.1.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
