    "@creativebulma/bulma-tooltip": "^1.2.0",
    "@types/activedirectory2": "^1.2.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/csurf": "^1.11.5",
    "@types/debug": "^4.1.13",
