<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
<meta name="csrf-token" content="<%= csrfToken %>" />

<link href="https://fonts.gstatic.com" rel="preconnect" />
<link href="https://fonts.googleapis.com/css2?family=Barlow:ital,wght@0,400;0,600;0,700;1,400;1,600;1,700&display=swap" rel="stylesheet" />
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed&display=swap" rel="stylesheet" />

<link href="<%= urlPrefix %>/stylesheets/style.css" rel="stylesheet" />
<link href="<%= urlPrefix %>/stylesheets/print.css" media="print" rel="stylesheet" />
<link href="<%= urlPrefix %>/lib/fa5/css/all.min.css" rel="stylesheet" />

<link href="<%= urlPrefix %>/apple-touch-icon.png" rel="apple-touch-icon" sizes="180x180" />
<link
  type="image/png"
  href="<%= urlPrefix %>/favicon-32x32.png"
  rel="icon"
  sizes="32x32"
/>
<link
  type="image/png"
  href="<%= urlPrefix %>/favicon-16x16.png"
  rel="icon"
  sizes="16x16"
/>
<link href="<%= urlPrefix %>/site.webmanifest" rel="manifest" />
<link href="<%= urlPrefix %>/safari-pinned-tab.svg" color="#363636" rel="mask-icon" />
<meta name="msapplication-TileColor" content="#8bd1c9" />
<meta name="theme-color" content="#8bd1c9" />

<% if (user) { %>
<link
  id="feed--atom-unfiltered"
  type="application/atom+xml"
  href="<%= urlPrefix %>/export/feed/atom/<%= user.userName %>/<%= user.guidA %>/<%= user.guidB %>?includeExpired=on"
  title="<%= configFunctions.getProperty('customizations.applicationName') %> Atom: <%= user.userName %> (Unfiltered)"
  rel="alternate"
/>

<link
  id="feed--rss2-unfiltered"
  type="application/rss+xml"
  href="<%= urlPrefix %>/export/feed/rss2/<%= user.userName %>/<%= user.guidA %>/<%= user.guidB %>?includeExpired=on"
  title="<%= configFunctions.getProperty('customizations.applicationName') %> RSS: <%= user.userName %> (Unfiltered)"
  rel="alternate"
/>
  
<link
  id="feed--json-unfiltered"
  type="application/feed+json"
  href="<%= urlPrefix %>/export/feed/json/<%= user.userName %>/<%= user.guidA %>/<%= user.guidB %>?includeExpired=on"
  title="<%= configFunctions.getProperty('customizations.applicationName') %> JSON: <%= user.userName %> (Unfiltered)"
  rel="alternate"
/>
<% } %>
